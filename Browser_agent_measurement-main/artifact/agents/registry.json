      "upstream_repo": "https://huggingface.co/zai-org/GLM-4.1V-9B-Thinking"
    },
    "som-gpt-5": {
      "agent_type": "research",
      "served_via": "openai_api",
      "served_model_name": "gpt-5",
      "step_budget": 100,
      "session_timeout_s": 600,
      "browser_engine": "chromium",
      "action_paradigm": "visible-element-som",
      "command_template": [
        "python", "${PROJECT_ROOT}/agents/som_gpt5/run_agent.py",
        "--task", "{task}"
      ],
      "task_input": "file",
      "env": {
